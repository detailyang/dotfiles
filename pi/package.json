{
  "name": "detailyang",
  "version": "2.0.0",
  "description": "detailyang pi coding agent commands, skills, extensions, and themes",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-theme"
  ],
  "scripts": {
    "check": "npm run check:types && npm run check:inventory && npm test",
    "check:types": "tsc -p tsconfig.json",
    "check:inventory": "node scripts/check-inventory.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "typebox": "1.3.7",
    "ws": "^8.18.0",
    "@shikijs/cli": "^4.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
